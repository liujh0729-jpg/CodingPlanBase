# 数据库（默认 SQLite，文件相对 prisma/ 目录解析）
DATABASE_URL="file:./dev.db"

# 服务端口
PORT=1690

# JWT 签名密钥（必填，缺失服务拒绝启动）
JWT_SECRET=change-this-local-development-secret
# 令牌签发方标识（可选）
JWT_ISSUER=codingplan-base
# 访问令牌有效期（可选，默认 24h）
JWT_EXPIRES_IN=24h

# CORS 允许的前端来源（逗号分隔；* 表示全部）
CORS_ORIGIN_PATTERNS=http://localhost:15889

# AIPDD 专用渠道（目录同步 + 转发上游）。密钥优先级：渠道表 > 后台设置(首次设置向导) > 本环境变量兜底
AIPDD_API_KEY=
AIPDD_BASE_URL=
# 零售定价倍率：批发价 ×1.10（默认，可留空）
AIPDD_PRICING_MARKUP=
# 目录定时同步间隔（分钟），0 关闭
AIPDD_CATALOG_SYNC_INTERVAL_MINUTES=5

# Chandler.work 联合登录与 B 端支付（后台「设置 → 开通」后才生效）
CHANDLER_BASE_URL=
CHANDLER_CLIENT_ID=
CHANDLER_CLIENT_SECRET=
# 下单/退款用的平台 API Key（账号需为目标应用 owner/admin/finance）
CHANDLER_API_KEY=

# 首次种子创建的超级管理员（pnpm prisma:seed）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_QUOTA=0
