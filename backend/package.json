{
  "name": "codingplan-base-api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest --config ./test/jest-unit.json",
    "prisma:generate": "prisma generate",
    "prisma:generate:mysql": "prisma generate --schema prisma/dialects/mysql.prisma",
    "prisma:generate:postgres": "prisma generate --schema prisma/dialects/postgresql.prisma",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "db:push:mysql": "prisma db push --schema prisma/dialects/mysql.prisma",
    "db:push:postgres": "prisma db push --schema prisma/dialects/postgresql.prisma",
    "db:apply:sqlite": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/sqlite/schema.sql",
    "db:apply:mysql": "prisma db execute --schema prisma/dialects/mysql.prisma --file prisma/sql/mysql/schema.sql",
    "db:apply:postgres": "prisma db execute --schema prisma/dialects/postgresql.prisma --file prisma/sql/postgresql/schema.sql",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "jsonwebtoken": "^9.0.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
